# Neon (PostgreSQL) の接続文字列。ローカルでは未設定にすると PGlite(.pglite/) を使う
# 本番(Vercel Production)は Neon の main ブランチ、Preview/ローカルは dev ブランチを指定する
DATABASE_URL=

# ローカルの PGlite の保存先（省略可。既定は .pglite）
PGLITE_DIR=

# Clerk (https://dashboard.clerk.com)。未設定でも閲覧はできるが、ログイン・投稿・いいねは無効になる
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk の Webhook(/api/webhooks/clerk) の署名シークレット。Webhook を登録してから設定する
CLERK_WEBHOOK_SIGNING_SECRET=
